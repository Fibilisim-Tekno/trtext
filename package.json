{
	"name": "trtext",
	"version": "0.1.1",
	"description": "Turkish-correct lowercase, uppercase, folding, slugs and alphabet sorting. Zero dependencies, no ICU required.",
	"keywords": [
		"turkish",
		"turkce",
		"locale",
		"tolowercase",
		"touppercase",
		"dotless-i",
		"slug",
		"slugify",
		"collation",
		"normalize",
		"diacritics",
		"i18n"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Fibilisim-Tekno/trtext.git"
	},
	"bugs": {
		"url": "https://github.com/Fibilisim-Tekno/trtext/issues"
	},
	"homepage": "https://github.com/Fibilisim-Tekno/trtext#readme",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist", "README.md", "LICENSE"],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "npm run build && node --test test/*.test.mjs",
		"prepublishOnly": "npm run test"
	},
	"devDependencies": {
		"typescript": "^5.6.0"
	}
}
